ADMIN_PASSWORD=replace_with_a_strong_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SHOPEE_AFFILIATE_ID=your_shopee_affiliate_id_number_only
YOU_API_KEY=your_you_com_api_key
# YDC_API_KEY is also supported as an alias for Vercel deployments.
SEARCH_RATE_LIMIT_PER_DAY=30

# Vercel Cron tự gửi giá trị này qua Authorization: Bearer <secret>.
CRON_SECRET=replace_with_a_random_string_at_least_16_characters
# Nguồn voucher chính thức, ưu tiên hơn scraping khi được cấu hình.
ACCESSTRADE_API_KEY=your_accesstrade_publisher_api_key

# Tùy chọn: dùng Browserless thay Chromium serverless tích hợp sẵn.
BROWSERLESS_WS_ENDPOINT=wss://your-browserless-endpoint
# Chỉ dùng khi chạy trên VPS/máy cục bộ với Chrome cài riêng.
PUPPETEER_EXECUTABLE_PATH=
